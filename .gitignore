
# ==========================================
# SkillShift AI - Git Ignore
# ==========================================

# Python / FastAPI
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables / Secrets
.env
.env.*
!.env.example
!.env.*.example
*.env.local

# Supabase Local Development
.supabase/
supabase/.branches/
supabase/.profiles/

# Node.js / Frontend Dependencies
node_modules/
.pnpm-store/
.yarn/
.npm/

# React / Vite / TypeScript Build Outputs
dist/
build/
.next/
out/
.docusaurus/
*.tsbuildinfo
vite.svg

# Frontend Testing / Coverage
coverage/
playwright-report/
test-results/
.eslintcache

# Package Manager Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Application Logs
*.log
logs/

# Temporary Files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.sublime-workspace

# Local Database Files (if used)
*.sqlite
*.sqlite3
*.db

# Local Runtime Files
*.pid
*.seed
