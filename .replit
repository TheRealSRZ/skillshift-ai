run = "bash scripts/start.sh"
entrypoint = "backend/main.py"

[nix]
channel = "stable-24_05"

[deployment]
build = ["bash", "-c", "python -m venv .venv && PIP_CONFIG_FILE=/dev/null .venv/bin/python -m pip install --no-user -r requirements.txt && bash scripts/build_frontend.sh"]
run = ["bash", "-c", "REQUIRE_FRONTEND_BUILD=true .venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]

