# Backend configuration — create a private .env locally or use Replit Secrets.
AI_ENABLED=false
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_POLL_TIMEOUT=30
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=
# AI personalization requires a signed-in Supabase user.
# Budgets apply to all attempted GPU jobs, including failed/timeout calls.
AI_DAILY_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=30
AI_MAX_CONCURRENT=1
AI_COOLDOWN_SECONDS=45
AI_SLOT_TTL_SECONDS=300
# AI_QUOTA_DB_PATH=/path/to/persistent-volume/ai_quotas.sqlite3
