# Backend configuration — create a private .env locally or use Replit Secrets.
AI_ENABLED=false
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_POLL_TIMEOUT=30
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=
# AI personalization requires a signed-in Supabase user.
# Budgets apply to all attempted GPU jobs, including failed/timeout calls.
AI_DAILY_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=30
AI_MAX_CONCURRENT=1
AI_COOLDOWN_SECONDS=45
AI_SLOT_TTL_SECONDS=300
# AI_QUOTA_DB_PATH=/path/to/persistent-volume/ai_quotas.sqlite3

# Phase 6 security boundary. APP_ENV=development by default (localhost tests).
# APP_ENV accepts only development, testing, production. Typos fail startup.
# Production requires comma-separated exact hostnames (NO wildcards or ports).
APP_ENV=development
# ALLOWED_HOSTS=YOUR_APP.replit.app
# API_RATE_DB_PATH=/path/to/persistent-volume/api_rate.sqlite3
API_RATE_PER_MINUTE=120
API_MAX_BODY_BYTES=32768
# Set HSTS only after the ENTIRE public domain is verified HTTPS-only.
SECURITY_HSTS_ENABLED=false
# If RUNPOD_POLL_TIMEOUT grows, increase AI_SLOT_TTL_SECONDS to poll timeout + 45s.
